# ================================================================
# PENDAMPING AMALAN DIGITAL — .gitignore
# Capacitor Android + Supabase + Firebase OTA
# ================================================================

# ───────────────────────────────────────────────────────────────
# 🔒 KEAMANAN & KREDENSIAL RAHASIA (WAJIB TIDAK DI-PUSH KE GIT)
# ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
serviceAccountKey.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json
update_*.zip
*.zip

# ───────────────────────────────────────────────────────────────
# DEPENDENSI & BUILD OUTPUT
# ───────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/

.DS_Store
Thumbs.db
logs/
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ───────────────────────────────────────────────────────────────
# FILE SISTEM OPERASI
# ───────────────────────────────────────────────────────────────

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS (jika developer menggunakan Mac)
.DS_Store
.AppleDouble
.LSOverride
._*

# ───────────────────────────────────────────────────────────────
# EDITOR & IDE
# ───────────────────────────────────────────────────────────────

# VS Code (settings sensitif, bukan extensions)
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# ───────────────────────────────────────────────────────────────
# FILE TEMP & BACKUP
# ───────────────────────────────────────────────────────────────

*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~

# ───────────────────────────────────────────────────────────────
# CATATAN DEVELOPER
# ───────────────────────────────────────────────────────────────
# package-lock.json SENGAJA tidak di-ignore agar versi dependensi
# antar developer/lingkungan tetap konsisten (reproducible builds).
# ================================================================
scratch/
github_recovery_codes.txt
.env

www/
android/
*.apk
